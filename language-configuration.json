{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "#[",
      "]#"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^[^#]*([{(\\[]|:)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*([})\\]]|elseif\\^|else\\^|other\\^)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(elseif\\^.*|else\\^|el\\^|when\\^.*|other\\^|catch\\^.*):\\s*(#.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
